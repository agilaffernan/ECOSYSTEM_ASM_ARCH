digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=1.20, nodesep=1.15, newrank=true, remincross=true, mclimit=8.0, splines=spline, outputorder=edgesfirst]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">8. Security Architecture</font><br /><font point-size="24">Authentication, secret injection, Workload Identity, TLS, and protected data paths.</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">ASM+ User</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Creates folders, uploads<br />files, searches content, and<br />views documents.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
  2 [id=2,shape=rect, label=<<font point-size="34">Platform<br />Administrator</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Operates ASM+, Kubernetes, and<br />Google Cloud resources.</font>>, style=filled, color="#1e293b", fillcolor="#334155", fontcolor="#ffffff"]
  5 [id=5,shape=rect, label=<<font point-size="34">Enterprise Identity<br />Provider</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Optional SAML or Microsoft<br />identity provider supported by<br />Auth; active provider<br />configuration was not<br />verified.</font>>, style=filled, color="#94a3b8", fillcolor="#f8fafc", fontcolor="#475569"]
  7 [id=7,shape=cylinder, label=<<font point-size="34">Cloud SQL for<br />PostgreSQL</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Private PostgreSQL 18 instance<br />asmplus-demo-postgres;<br />database auritasdemo contains<br />23 application tables.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
  8 [id=8,shape=cylinder, label=<<font point-size="34">Cloud Storage</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Private bucket<br />sap-ecosystem-asmplus-asm-binaries<br />stores document binaries and<br />ASM manifests.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
  9 [id=9,shape=cylinder, label=<<font point-size="34">Secret Manager</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Stores the five observed core<br />secret objects; secret values<br />are not represented in this<br />model.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]

  subgraph cluster_13 {
    margin=25
    label=<<font point-size="24"><br />ASM+</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    subgraph "cluster_group_Application APIs" {
      margin=25
      label=<<font point-size="24"><br />Application APIs</font>>
      labelloc=b
      color="#cccccc"
      fontcolor="#cccccc"
      fillcolor="#ffffff"
      style="dashed"

      32 [id=32,shape=hexagon, label=<<font point-size="34">Auth API</font><br /><font point-size="19">[Container: Node.js, TypeScript, Express; port 3000]</font><br /><br /><font point-size="24">Authenticates users, issues<br />JWTs, and administers<br />applications, roles,<br />structures, SSO, and access.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff"]
      38 [id=38,shape=hexagon, label=<<font point-size="34">ASM+ API</font><br /><font point-size="19">[Container: Node.js, TypeScript, Express; port 3000]</font><br /><br /><font point-size="24">Orchestrates document<br />metadata, access, workflows,<br />notifications, reports, audit,<br />and binary operations.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff"]
      47 [id=47,shape=hexagon, label=<<font point-size="34">SAP API</font><br /><font point-size="19">[Container: Node.js, TypeScript, Express; port 3020]</font><br /><br /><font point-size="24">Provides SAP<br />ArchiveLink-compatible<br />document operations and SAP<br />viewer launch support.</font>>, style=filled, color="#92400e", fillcolor="#b45309", fontcolor="#ffffff"]
      55 [id=55,shape=hexagon, label=<<font point-size="34">Salesforce API</font><br /><font point-size="19">[Container: Node.js, TypeScript, Express; port 3030]</font><br /><br /><font point-size="24">Provides Salesforce<br />repository/document operations<br />and token issuance.</font>>, style=filled, color="#92400e", fillcolor="#b45309", fontcolor="#ffffff"]
    }

    subgraph "cluster_group_Storage Core" {
      margin=25
      label=<<font point-size="24"><br />Storage Core</font>>
      labelloc=b
      color="#cccccc"
      fontcolor="#cccccc"
      fillcolor="#ffffff"
      style="dashed"

      63 [id=63,shape=hexagon, label=<<font point-size="34">ASM Storage API</font><br /><font point-size="19">[Container: Node.js, TypeScript, Express; port 3000]</font><br /><br /><font point-size="24">Internal storage service for<br />document components,<br />manifests, licenses, and<br />certificates.</font>>, style=filled, color="#6d28d9", fillcolor="#7c3aed", fontcolor="#ffffff"]
    }

    subgraph "cluster_group_Web Experience" {
      margin=25
      label=<<font point-size="24"><br />Web Experience</font>>
      labelloc=b
      color="#cccccc"
      fontcolor="#cccccc"
      fillcolor="#ffffff"
      style="dashed"

      14 [id=14,shape=rect, label=<<font point-size="34">Auth Portal</font><br /><font point-size="19">[Container: React, Vite, NGINX]</font><br /><br /><font point-size="24">Login, SSO, and<br />access-administration web<br />application.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
      19 [id=19,shape=rect, label=<<font point-size="34">ASM+ Web Application</font><br /><font point-size="19">[Container: React, Vite, Node static server]</font><br /><br /><font point-size="24">Primary document, workflow,<br />report, search, and<br />administration UI.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
      26 [id=26,shape=rect, label=<<font point-size="34">Document Viewer</font><br /><font point-size="19">[Container: React, Vite, Node static server]</font><br /><br /><font point-size="24">Displays files retrieved from<br />ASM+ or SAP integration<br />endpoints.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
    }

    72 [id=72,shape=cylinder, label=<<font point-size="34">Runtime Secrets</font><br /><font point-size="19">[Container: Kubernetes Opaque Secret]</font><br /><br /><font point-size="24">Namespace-scoped secret<br />containing the seven keys<br />observed in the live<br />deployment; values are not<br />modeled.</font>>, style=filled, color="#326ce5", fillcolor="#ffffff", fontcolor="#172033"]
  }

  47 -> 26 [id=100, label=<<font point-size="18">Redirects browser-origin SAP launch<br />requests</font><br /><font point-size="13">[HTTPS with bounded viewer token]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  38 -> 63 [id=101, label=<<font point-size="18">Reads and writes document objects,<br />manifests, licenses, and<br />certificates</font><br /><font point-size="13">[HTTP/REST, X-Api-Key]</font>>, style="dashed", color="#7c3aed", fontcolor="#7c3aed"]
  47 -> 63 [id=102, label=<<font point-size="18">Reads and writes SAP document<br />objects and certificates</font><br /><font point-size="13">[HTTP/REST, X-Api-Key]</font>>, style="dashed", color="#7c3aed", fontcolor="#7c3aed"]
  55 -> 63 [id=103, label=<<font point-size="18">Reads and writes Salesforce document<br />and registry objects</font><br /><font point-size="13">[HTTP/REST, X-Api-Key]</font>>, style="dashed", color="#7c3aed", fontcolor="#7c3aed"]
  32 -> 7 [id=104, label=<<font point-size="18">Reads and writes identity and access<br />tables through a local Cloud SQL<br />Auth Proxy</font><br /><font point-size="13">[PostgreSQL on 127.0.0.1:5432]</font>>, style="dashed", color="#166534", fontcolor="#166534"]
  38 -> 7 [id=105, label=<<font point-size="18">Reads and writes document metadata,<br />RBAC, workflow, audit, and reporting<br />tables through a local proxy</font><br /><font point-size="13">[PostgreSQL on 127.0.0.1:5432]</font>>, style="dashed", color="#166534", fontcolor="#166534"]
  47 -> 7 [id=106, label=<<font point-size="18">Persists SAP document hierarchy and<br />metadata through a local proxy</font><br /><font point-size="13">[PostgreSQL on 127.0.0.1:5432]</font>>, style="dashed", color="#166534", fontcolor="#166534"]
  55 -> 7 [id=107, label=<<font point-size="18">Persists Salesforce document<br />hierarchy and metadata through a<br />local proxy</font><br /><font point-size="13">[PostgreSQL on 127.0.0.1:5432]</font>>, style="dashed", color="#166534", fontcolor="#166534"]
  63 -> 8 [id=108, label=<<font point-size="18">Stores and retrieves binaries,<br />manifests, licenses, and<br />certificates using ADC</font><br /><font point-size="13">[GCS API over HTTPS]</font>>, style="dashed", color="#047857", fontcolor="#047857"]
  9 -> 72 [id=109, label=<<font point-size="18">Provides approved core secret<br />material during provisioning</font><br /><font point-size="13">[Administrative provisioning path]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  72 -> 32 [id=119, label=<<font point-size="18">Injects database, JWT, superadmin,<br />and client-key secrets</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  72 -> 38 [id=120, label=<<font point-size="18">Injects database, JWT, internal API,<br />and optional vector secrets</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  72 -> 47 [id=121, label=<<font point-size="18">Injects database, JWT, internal API,<br />and SAP user secrets</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  72 -> 55 [id=122, label=<<font point-size="18">Injects database, internal API,<br />Salesforce user, and optional vector<br />secrets</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  72 -> 63 [id=123, label=<<font point-size="18">Injects the internal ASM API key</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  72 -> 19 [id=124, label=<<font point-size="18">Injects the Auth client key</font><br /><font point-size="13">[Environment variable]</font>>, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  32 -> 5 [id=171, label=<<font point-size="18">Exchanges assertions when configured</font><br /><font point-size="13">[SAML/Microsoft]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  1 -> 19 [id=82, label=<<font point-size="18">Uses the main application</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  1 -> 14 [id=83, label=<<font point-size="18">Signs in and manages a profile</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  1 -> 26 [id=84, label=<<font point-size="18">Views document content</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  2 -> 14 [id=85, label=<<font point-size="18">Administers users, roles,<br />applications, structures, and<br />connections</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  5 -> 32 [id=89, label=<<font point-size="18">Provides optional federated identity<br />assertions</font><br /><font point-size="13">[SAML 2.0 or Microsoft identity]</font>>, style="dashed", color="#94a3b8", fontcolor="#94a3b8"]
  14 -> 32 [id=91, label=<<font point-size="18">Authenticates users and administers<br />identity/access data</font><br /><font point-size="13">[HTTPS/JSON]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  19 -> 14 [id=92, label=<<font point-size="18">Redirects the browser to the SSO<br />portal</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#b91c1c", fontcolor="#b91c1c"]
  19 -> 32 [id=93, label=<<font point-size="18">Authenticates and checks application<br />access</font><br /><font point-size="13">[HTTPS/JSON, JWT]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  19 -> 38 [id=94, label=<<font point-size="18">Performs document, workflow, report,<br />search, and audit operations</font><br /><font point-size="13">[HTTPS/JSON and binary]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  19 -> 26 [id=95, label=<<font point-size="18">Launches the selected document</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  26 -> 14 [id=96, label=<<font point-size="18">Redirects the browser to SSO when a<br />session is absent</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#b91c1c", fontcolor="#b91c1c"]
  26 -> 32 [id=97, label=<<font point-size="18">Validates authentication and<br />application access</font><br /><font point-size="13">[HTTPS/JSON, JWT]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  26 -> 38 [id=98, label=<<font point-size="18">Retrieves ASM+ metadata and file<br />content</font><br /><font point-size="13">[HTTPS/JSON and HTTP range]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  26 -> 47 [id=99, label=<<font point-size="18">Retrieves SAP-origin document<br />components</font><br /><font point-size="13">[HTTPS/ArchiveLink]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]

}