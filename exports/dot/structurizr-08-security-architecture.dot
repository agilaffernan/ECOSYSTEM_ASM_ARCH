  71 -> 54 [id=119, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  71 -> 62 [id=120, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  71 -> 18 [id=121, style="dashed", color="#9f1239", fontcolor="#9f1239"]
  1 -> 13 [id=82, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  2 -> 13 [id=84, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  13 -> 31 [id=88, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  18 -> 31 [id=90, label=<<font point-size="18">Authenticates and checks application<br />access</font><br /><font point-size="13">[HTTPS/JSON, JWT]</font>>, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  25 -> 31 [id=94, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  37 -> 62 [id=98, style="dashed", color="#7c3aed", fontcolor="#7c3aed"]
  46 -> 62 [id=99, style="dashed", color="#7c3aed", fontcolor="#7c3aed"]

}