digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=0.48, nodesep=0.48, newrank=true, remincross=true, mclimit=8.0, splines=ortho, outputorder=edgesfirst]
  node [fontname="Arial", shape=box, margin="0.24,0.16"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">3F. Component Architecture - ASM+ Web Application</font><br /><font point-size="24">Internal structure of the main ASM+ web application.</font>>

  subgraph cluster_12 {
    margin=25
    label=<<font point-size="24"><br />ASM+</font><br /><font point-size="19">[Software System]</font>>
    labelloc=b
    color="#444444"
    fontcolor="#444444"
    fillcolor="#444444"

    subgraph cluster_18 {
      margin=25
      label=<<font point-size="24"><br />ASM+ Web Application</font><br /><font point-size="19">[Container: React, Vite, Node static server]</font>>
      labelloc=b
      color="#444444"
      fontcolor="#444444"
      fillcolor="#444444"

      19 [id=19,shape=folder, label=<<br /><br /><br /><font point-size="27">Runtime Configuration<br />Loader</font><br /><font point-size="15">[Component: JavaScript]</font><br /><br /><font point-size="18">Loads public endpoint URLs and<br />feature switches from<br />runtime-config.js.</font>>, style=filled, color="#64748b", fillcolor="#e2e8f0", fontcolor="#172033"]
      20 [id=20,shape=component, label=<<br /><br /><br /><font point-size="27">Application Shell and<br />Router</font><br /><font point-size="15">[Component: React]</font><br /><br /><font point-size="18">Coordinates navigation,<br />layouts, notifications, and<br />error handling.</font>>, style=filled, color="#64748b", fillcolor="#f8fafc", fontcolor="#172033"]
      21 [id=21,shape=component, label=<<font point-size="27">Authentication<br />Context</font><br /><font point-size="15">[Component: React Context]</font><br /><br /><font point-size="18">Processes SSO callbacks,<br />retains the JWT, and applies<br />client-side authorization.</font>>, style=filled, color="#64748b", fillcolor="#f8fafc", fontcolor="#172033"]
      22 [id=22,shape=component, label=<<br /><br /><br /><font point-size="27">Document and Workflow<br />UI</font><br /><font point-size="15">[Component: React]</font><br /><br /><font point-size="18">Implements folders, files,<br />recycle bin, workflows,<br />reports, audit, and search<br />experiences.</font>>, style=filled, color="#64748b", fillcolor="#f8fafc", fontcolor="#172033"]
      23 [id=23,shape=component, label=<<br /><br /><br /><font point-size="27">ASM+ API Client</font><br /><font point-size="15">[Component: Fetch/JSON and binary]</font><br /><br /><font point-size="18">Calls the ASM+ API and<br />notification/workflow<br />endpoints.</font>>, style=filled, color="#64748b", fillcolor="#f8fafc", fontcolor="#172033"]
      24 [id=24,shape=component, label=<<br /><br /><br /><font point-size="27">Viewer URL Builder</font><br /><font point-size="15">[Component: JavaScript]</font><br /><br /><font point-size="18">Launches the document viewer<br />with the selected document<br />context.</font>>, style=filled, color="#64748b", fillcolor="#f8fafc", fontcolor="#172033"]
    }

    25 [id=25,shape=rect, label=<<br /><br /><br /><font point-size="27">Document Viewer</font><br /><font point-size="15">[Container: React, Vite, Node static server]</font><br /><br /><font point-size="18">Displays files retrieved from<br />ASM+ or SAP integration<br />endpoints.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
    31 [id=31,shape=hexagon, label=<<font point-size="27">Auth API</font><br /><font point-size="15">[Container: Node.js, TypeScript, Express; port 3000]</font><br /><br /><font point-size="18">Authenticates users, issues<br />JWTs, and administers<br />applications, roles,<br />structures, SSO, and access.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff"]
    37 [id=37,shape=hexagon, label=<<font point-size="27">ASM+ API</font><br /><font point-size="15">[Container: Node.js, TypeScript, Express; port 3000]</font><br /><br /><font point-size="18">Orchestrates document<br />metadata, access, workflows,<br />notifications, reports, audit,<br />and binary operations.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff"]
    70 [id=70,shape=folder, label=<<br /><br /><br /><font point-size="27">Runtime Configuration</font><br /><font point-size="15">[Container: Kubernetes ConfigMaps]</font><br /><br /><font point-size="18">Non-secret environment<br />configuration supplied by<br />Kubernetes ConfigMaps.</font>>, style=filled, color="#326ce5", fillcolor="#ffffff", fontcolor="#172033"]
  }

  70 -> 25 [id=110, style="dashed", color="#64748b", fontcolor="#64748b"]
  70 -> 31 [id=111, style="dashed", color="#64748b", fontcolor="#64748b"]
  70 -> 37 [id=112, label=<<font point-size="18">Injects non-secret runtime<br />configuration</font><br /><font point-size="13">[Environment variables]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  19 -> 70 [id=145, label=<<font point-size="18">Reads startup configuration</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  20 -> 21 [id=147, label=<<font point-size="18">Uses</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  20 -> 22 [id=148, label=<<font point-size="18">Hosts</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  22 -> 23 [id=149, label=<<font point-size="18">Uses</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  22 -> 24 [id=150, label=<<font point-size="18">Uses</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  21 -> 31 [id=151, style="dashed", color="#64748b", fontcolor="#64748b"]
  23 -> 37 [id=152, style="dashed", color="#64748b", fontcolor="#64748b"]
  24 -> 25 [id=153, label=<<font point-size="18">Launches</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  25 -> 70 [id=155, label=<<font point-size="18">Reads startup configuration</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  25 -> 31 [id=94, style="dashed", color="#2563eb", fontcolor="#2563eb"]
  25 -> 37 [id=95, style="dashed", color="#2563eb", fontcolor="#2563eb"]

}