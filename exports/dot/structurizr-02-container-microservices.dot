digraph {
  compound=true
  graph [fontname="Arial", rankdir=TB, ranksep=0.62, nodesep=0.32, newrank=true, remincross=true, mclimit=8.0, splines=ortho, outputorder=edgesfirst]
  node [fontname="Arial", shape=box, margin="0.24,0.16"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">2. Container and Microservices Architecture</font><br /><font point-size="24">The eight deployed workloads and their principal runtime dependencies.</font>>

  subgraph cluster_12 {
    margin=22
    label=""
    color="#64748b"
    style="rounded"

    subgraph cluster_layer_frontend {
      margin=20
      label=<<font point-size="21"><b>Frontend Layer</b></font>>
      labelloc=t
      color="#93c5fd"
      fontcolor="#1d4ed8"
      fillcolor="#eff6ff"
      style="rounded,filled"

      13 [id=13,shape=rect, label=<<br /><br /><font point-size="16"><b>Auth Portal</b></font><br /><font point-size="13">[Container: React/Vite<br />NGINX]</font><br /><br /><font point-size="16">Login, SSO, and<br />access-administration web<br />application.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=3.95, height=2.5]
      18 [id=18,shape=rect, label=<<br /><br /><br /><font point-size="16"><b>ASM+ Web Application</b></font><br /><font point-size="13">[Container: React/Vite<br />Node static server]</font><br /><br /><font point-size="16">Primary document, workflow,<br />report, search, and<br />administration UI.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=3.95, height=2.5]
      25 [id=25,shape=rect, label=<<br /><br /><br /><font point-size="16"><b>Document Viewer</b></font><br /><font point-size="13">[Container: React/Vite<br />Node static server]</font><br /><br /><font point-size="16">Displays files retrieved from<br />ASM+ or SAP integration<br />endpoints.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=3.95, height=2.5]
    }

    subgraph cluster_layer_backend {
      margin=20
      label=<<font point-size="21"><b>Backend and API Layer</b></font>>
      labelloc=t
      color="#99f6e4"
      fontcolor="#0f766e"
      fillcolor="#f0fdfa"
      style="rounded,filled"

      31 [id=31,shape=hexagon, label=<<font point-size="16"><b>Auth API</b></font><br /><font point-size="13">[Container: Node.js/Express<br />port 3000]</font><br /><br /><font point-size="16">Authenticates users, issues<br />JWTs, and administers<br />applications, roles,<br />structures, SSO, and access.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=6, height=3.65]
      37 [id=37,shape=hexagon, label=<<font point-size="16"><b>ASM+ API</b></font><br /><font point-size="13">[Container: Node.js/Express<br />port 3000]</font><br /><br /><font point-size="16">Orchestrates document<br />metadata, access, workflows,<br />notifications, reports, audit,<br />and binary operations.</font>>, style=filled, color="#115e59", fillcolor="#0f766e", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=6, height=3.65]
      62 [id=62,shape=hexagon, label=<<font point-size="16"><b>ASM Storage API</b></font><br /><font point-size="13">[Container: Node.js/Express<br />port 3000]</font><br /><br /><font point-size="16">Internal storage service for<br />document components,<br />manifests, licenses, and<br />certificates.</font>>, style=filled, color="#4c1d95", fillcolor="#4c1d95", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=6, height=3.65, penwidth=5, peripheries=2]
      46 [id=46,shape=hexagon, label=<<font point-size="16"><b>SAP API</b></font><br /><font point-size="13">[Container: Node.js/Express<br />port 3020]</font><br /><br /><font point-size="16">Provides SAP<br />ArchiveLink-compatible<br />document operations and SAP<br />viewer launch support.</font>>, style=filled, color="#92400e", fillcolor="#b45309", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=6, height=3.65]
      54 [id=54,shape=hexagon, label=<<font point-size="16"><b>SAP SuccessFactors<br />API</b></font><br /><font point-size="13">[Container: Node.js/Express<br />port 3030]</font><br /><br /><font point-size="16">Provides SAP SuccessFactors<br />repository/document operations<br />and token issuance.</font>>, style=filled, color="#92400e", fillcolor="#b45309", fontcolor="#ffffff", labelloc=c, fixedsize=true, width=6, height=3.65]
    }
  }

  subgraph cluster_layer_data {
    margin=20
    label=<<font point-size="21"><b>Data Storage Layer</b></font>>
    labelloc=t
    color="#86efac"
    fontcolor="#166534"
    fillcolor="#f0fdf4"
    style="rounded,filled"

    6 [id=6,shape=cylinder, label=<<font point-size="16"><b>Cloud SQL for<br />PostgreSQL</b></font><br /><font point-size="13">[Software System]</font><br /><br /><font point-size="16">Private PostgreSQL 18 instance<br />asmplus-demo-postgres;<br />database auritasdemo contains<br />23 application tables.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033", labelloc=c, fixedsize=true, width=4.35, height=3.15]
    7 [id=7,shape=cylinder, label=<<font point-size="16"><b>Cloud Storage</b></font><br /><font point-size="13">[Software System]</font><br /><br /><font point-size="16">Private bucket<br />sap-ecosystem-asmplus-asm-binaries<br />stores document binaries and<br />ASM manifests.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033", labelloc=c, fixedsize=true, width=4.35, height=3.15]
  }

  54 -> 62 [id=100, style="dashed", color="#7c3aed", fontcolor="#7c3aed", constraint=false]
  31 -> 6 [id=101, style="dashed", color="#166534", fontcolor="#166534", constraint=false]
  37 -> 6 [id=102, style="dashed", color="#166534", fontcolor="#166534", constraint=false]
  46 -> 6 [id=103, style="dashed", color="#166534", fontcolor="#166534", constraint=false]
  54 -> 6 [id=104, style="dashed", color="#166534", fontcolor="#166534", constraint=false]
  62 -> 7 [id=105, style="dashed", color="#047857", fontcolor="#047857", constraint=false]
  13 -> 31 [id=88, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  18 -> 31 [id=90, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  18 -> 37 [id=91, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  18 -> 25 [id=92, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  25 -> 31 [id=94, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  25 -> 37 [id=95, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  25 -> 46 [id=96, style="dashed", color="#2563eb", fontcolor="#2563eb", constraint=false]
  37 -> 62 [id=98, style="dashed", color="#7c3aed", fontcolor="#7c3aed", constraint=false]
  46 -> 62 [id=99, style="dashed", color="#7c3aed", fontcolor="#7c3aed", constraint=false]

  { rank=same; 13; 18; 25; }
  { rank=same; 31; 37; 62; 46; 54; }
  { rank=same; 6; 7; }
  13 -> 18 -> 25 [style=invis, weight=180]
  31 -> 37 -> 62 -> 46 -> 54 [style=invis, weight=220]
  6 -> 7 [style=invis, weight=180]
  18 -> 62 [style=invis, weight=500, minlen=3]
  62 -> 6 [style=invis, weight=500, minlen=3]
}
