digraph {
  compound=true
  graph [fontname="Arial", rankdir=LR, ranksep=1.08, nodesep=1.08, newrank=true, remincross=true, mclimit=8.0, splines=spline, outputorder=edgesfirst]
  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">1. System Context</font><br /><font point-size="24">ASM+ users, integrations, and managed service dependencies.</font>>

  1 [id=1,shape=rect, label=<<font point-size="34">ASM+ User</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Creates folders, uploads<br />files, searches content, and<br />views documents.</font>>, style=filled, color="#1d4ed8", fillcolor="#2563eb", fontcolor="#ffffff"]
  11 [id=11,shape=rect, label=<<font point-size="34">Cloud Logging and<br />Monitoring</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Receives GKE system/workload<br />logs and platform metrics. No<br />custom alert policies were<br />observed.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
  13 [id=13,shape=rect, label=<<font point-size="34">ASM+</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Document management,<br />authentication, viewing, and<br />SAP/Salesforce integrations<br />deployed on GKE.</font>>, style=filled, color="#991b1b", fillcolor="#b91c1c", fontcolor="#ffffff"]
  2 [id=2,shape=rect, label=<<font point-size="34">Platform<br />Administrator</font><br /><font point-size="19">[Person]</font><br /><br /><font point-size="24">Operates ASM+, Kubernetes, and<br />Google Cloud resources.</font>>, style=filled, color="#1e293b", fillcolor="#334155", fontcolor="#ffffff"]
  3 [id=3,shape=rect, label=<<font point-size="34">SAP System</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Calls the SAP<br />ArchiveLink-compatible<br />interface for document storage<br />and retrieval.</font>>, style=filled, color="#0070b1", fillcolor="#ffffff", fontcolor="#172033"]
  4 [id=4,shape=rect, label=<<font point-size="34">Salesforce</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Calls the Salesforce<br />document/repository<br />integration and token<br />endpoints.</font>>, style=filled, color="#b45309", fillcolor="#f59e0b", fontcolor="#172033"]
  5 [id=5,shape=rect, label=<<font point-size="34">Enterprise Identity<br />Provider</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Optional SAML or Microsoft<br />identity provider supported by<br />Auth; active provider<br />configuration was not<br />verified.</font>>, style=filled, color="#94a3b8", fillcolor="#f8fafc", fontcolor="#475569"]
  6 [id=6,shape=rect, label=<<font point-size="34">Auritas DNS</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Publishes seven A records<br />under<br />asmplus-demo.auritas.com.</font>>, style=filled, color="#64748b", fillcolor="#e2e8f0", fontcolor="#172033"]
  7 [id=7,shape=cylinder, label=<<font point-size="34">Cloud SQL for<br />PostgreSQL</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Private PostgreSQL 18 instance<br />asmplus-demo-postgres;<br />database auritasdemo contains<br />23 application tables.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
  8 [id=8,shape=cylinder, label=<<font point-size="34">Cloud Storage</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Private bucket<br />sap-ecosystem-asmplus-asm-binaries<br />stores document binaries and<br />ASM manifests.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]

  13 -> 5 [id=172, label=<<font point-size="18">Exchanges assertions when configured</font><br /><font point-size="13">[SAML/Microsoft]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  1 -> 13 [id=73, label=<<font point-size="18">Uses document management and viewing<br />capabilities</font><br /><font point-size="13">[HTTPS]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  2 -> 13 [id=74, label=<<font point-size="18">Administers application access and<br />operations</font><br /><font point-size="13">[HTTPS and kubectl]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  3 -> 13 [id=75, label=<<font point-size="18">Stores and retrieves SAP documents</font><br /><font point-size="13">[ArchiveLink over HTTPS]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  4 -> 13 [id=76, label=<<font point-size="18">Stores and retrieves Salesforce<br />documents</font><br /><font point-size="13">[REST over HTTPS]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  13 -> 7 [id=77, label=<<font point-size="18">Stores application metadata</font><br /><font point-size="13">[PostgreSQL]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  13 -> 8 [id=78, label=<<font point-size="18">Stores document binaries and<br />manifests</font><br /><font point-size="13">[GCS JSON API over HTTPS]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  13 -> 11 [id=79, label=<<font point-size="18">Emits workload logs and metrics</font><br /><font point-size="13">[Cloud Operations agents]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  6 -> 13 [id=81, label=<<font point-size="18">Resolves seven public hostnames to<br />34.36.209.159</font><br /><font point-size="13">[DNS A records]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  2 -> 11 [id=86, label=<<font point-size="18">Inspects logs, metrics, and workload<br />health</font><br /><font point-size="13">[Google Cloud Console and gcloud]</font>>, style="dashed", color="#64748b", fontcolor="#64748b"]
  5 -> 13 [id=90, label=<<font point-size="18">Provides optional federated identity<br />assertions</font><br /><font point-size="13">[SAML 2.0 or Microsoft identity]</font>>, style="dashed", color="#94a3b8", fontcolor="#94a3b8"]

}