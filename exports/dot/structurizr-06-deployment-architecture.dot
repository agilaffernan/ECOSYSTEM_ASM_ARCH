      fontcolor="#172033"
      fillcolor="#ffffff"

      215 [id=215,shape=rect, label=<<font point-size="34">Managed Certificate</font><br /><font point-size="19">[Infrastructure Node: GKE ManagedCertificate]</font><br /><br /><font point-size="24">Active certificate<br />asmplus-demo-certificate-v2<br />for all seven hostnames.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
      216 [id=216,shape=hexagon, label=<<font point-size="34">Global External<br />Application Load<br />Balancer</font><br /><font point-size="19">[Infrastructure Node: GCE Ingress, FrontendConfig]</font><br /><br /><font point-size="24">Static IPv4 34.36.209.159;<br />HTTP redirects permanently to<br />HTTPS.</font>>, style=filled, color="#4285f4", fillcolor="#ffffff", fontcolor="#172033"]
      subgraph cluster_217 {
        margin=25
