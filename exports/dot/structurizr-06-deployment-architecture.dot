    212 [id=212,shape=rect, label=<<font point-size="34">Auritas DNS</font><br /><font point-size="19">[Software System]</font><br /><br /><font point-size="24">Publishes seven A records<br />under<br />asmplus-demo.auritas.com.</font>>, style=filled, color="#64748b", fillcolor="#e2e8f0", fontcolor="#172033"]
  }

  subgraph cluster_213 {
