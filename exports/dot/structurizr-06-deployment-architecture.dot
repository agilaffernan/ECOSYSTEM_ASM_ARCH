            221 [id=221,shape=rect, label=<<font point-size="34">Helm Release:<br />asm-plus-demo</font><br /><font point-size="19">[Infrastructure Node: Helm]</font><br /><br /><font point-size="24">Renders and manages the ASM+<br />Kubernetes resources from the<br />ecosystem chart and GCP values<br />files.</font>>, style=filled, color="#0f1689", fillcolor="#ffffff", fontcolor="#172033"]
            222 [id=222,shape=folder, label=<<font point-size="34">Runtime Configuration</font><br /><font point-size="19">[Container: Kubernetes ConfigMaps]</font><br /><br /><font point-size="24">Non-secret environment<br />configuration supplied by<br />Kubernetes ConfigMaps.</font>>, style=filled, color="#326ce5", fillcolor="#ffffff", fontcolor="#172033"]
            223 [id=223,shape=cylinder, label=<<font point-size="34">Runtime Secrets</font><br /><font point-size="19">[Container: Kubernetes Opaque Secret]</font><br /><br /><font point-size="24">Namespace-scoped secret<br />containing the seven keys<br />observed in the live<br />deployment; values are not<br />modeled.</font>>, style=filled, color="#326ce5", fillcolor="#ffffff", fontcolor="#172033"]
