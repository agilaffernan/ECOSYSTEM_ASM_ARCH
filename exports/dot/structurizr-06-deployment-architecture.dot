  node [fontname="Arial", shape=box, margin="0.4,0.3"]
  edge [fontname="Arial"]
  label=<<br /><font point-size="34">6. Deployment Architecture</font><br /><font point-size="24">Physical deployment of ASM+ in the live Google Cloud project.</font>>

  subgraph cluster_211 {
