          fontcolor="#172033"
          fillcolor="#ffffff"

          219 [id=219,shape=rect, label=<<font point-size="34">Kubelet and<br />containerd</font><br /><font point-size="19">[Infrastructure Node: GKE node runtime]</font><br /><br /><font point-size="24">Pulls images, runs containers,<br />reports logs and metrics.</font>>, style=filled, color="#326ce5", fillcolor="#ffffff", fontcolor="#172033"]
          subgraph cluster_220 {
